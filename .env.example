# ── Required ────────────────────────────────────────────────────────────────
# The address people open in their browser (https:// for microphones to work).
PINGO_URL=https://chat.example.com
# The server's public IP address(es), comma-separated. Browsers send audio and
# video here on PINGO_UDP_PORT, so it must be reachable from your users.
PINGO_PUBLIC_IPS=203.0.113.10
# A long random secret that signs call tokens: `openssl rand -hex 32`.
PINGO_MEDIA_SECRET=

# ── Who can join ────────────────────────────────────────────────────────────
# open:   anyone can create an account (default)
# invite: new accounts must use an invite link. The very first account can
#         create the first space; everyone after that needs an invite.
PINGO_REGISTRATION=open
# Optional: only these addresses or domains may use the server, e.g.
#   PINGO_ALLOWED_EMAILS=ada@example.com, @mycompany.com
# Addresses must be confirmed by email, so set up SMTP below.
PINGO_ALLOWED_EMAILS=

# ── Email (magic links, email confirmation) ─────────────────────────────────
# RXFERRIX_SMTP_URL=smtps://user:password@smtp.example.com:465
# RXFERRIX_SMTP_FROM=Pingo <noreply@example.com>

# ── Optional ────────────────────────────────────────────────────────────────
# With the https profile: the domain Caddy requests a certificate for.
# PINGO_DOMAIN=chat.example.com
# Behind Caddy or another reverse proxy, so rate limits see real client IPs.
# RXFERRIX_TRUST_PROXY=true
# PINGO_HTTP_PORT=8090
# PINGO_UDP_PORT=40000
# Sign in with GitHub / Google / Discord:
# RXFERRIX_AUTH_GITHUB_CLIENT_ID=
# RXFERRIX_AUTH_GITHUB_CLIENT_SECRET=
