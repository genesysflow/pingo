{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pingo",
  "version": "0.1.0",
  "identifier": "chat.pingo.desktop",
  "build": {
    "beforeDevCommand": "cd ../web && bun run dev --port 5173 --strictPort",
    "beforeBuildCommand": "cd ../web && bun run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Pingo", "width": 1280, "height": 850, "minWidth": 780, "minHeight": 560 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http: https: data: blob:; font-src 'self' data:; connect-src 'self' ipc: http: https: ws: wss:; media-src 'self' blob: http: https:; worker-src 'self' blob:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "category": "SocialNetworking",
    "shortDescription": "A little space for your people",
    "createUpdaterArtifacts": false,
    "linux": { "deb": { "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1", "libopus0", "libasound2"] }, "appimage": { "bundleMediaFramework": true } },
    "macOS": { "minimumSystemVersion": "12.0", "infoPlist": "Info.plist" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["pingo"] } },
    "updater": { "endpoints": [], "pubkey": "" }
  }
}
